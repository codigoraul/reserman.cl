---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Página no encontrada" description="La página que buscas no existe.">
  <section class="py-32 text-center">
    <div class="container-site">
      <p class="eyebrow">Error 404</p>
      <h1 class="mt-3 text-4xl font-bold text-navy-600">Página no encontrada</h1>
      <p class="mt-4 text-steel-700">La página que buscas no existe o fue movida.</p>
      <a href="/" class="btn-primary mt-8">Volver al inicio</a>
    </div>
  </section>
</Layout>
