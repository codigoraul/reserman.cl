---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import CtaBanner from '../components/CtaBanner.astro';
import Icon from '../components/Icon.astro';
import { getSomos } from '../lib/wp';

const somos = await getSomos();
---

<Layout
  title="Quiénes somos"
  description="Reserman nace de más de una década liderando departamentos de mantenimiento, ingeniería y prevención de riesgos en la industria alimentaria, química y cosmética."
>
  <PageHeader
    eyebrow="Somos"
    titulo={somos.titulo}
    texto="Experiencia real de planta, ahora al servicio de tu operación."
    crumbs={[{ label: 'Somos' }]}
    imagen="/headers/header-somos.webp"
  />

  <section class="py-20">
    <div class="container-site grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <p class="text-lg leading-relaxed text-steel-700">{somos.intro}</p>
      </div>
      <aside class="space-y-5 lg:col-span-5">
        <div class="rounded-xl border border-steel-200 bg-steel-100 p-6">
          <h2 class="text-sm font-semibold uppercase tracking-[0.18em] text-orange-500">Misión</h2>
          <p class="mt-3 leading-relaxed text-navy-600">{somos.mision}</p>
        </div>
        <div class="rounded-xl border border-steel-200 bg-steel-100 p-6">
          <h2 class="text-sm font-semibold uppercase tracking-[0.18em] text-orange-500">Visión</h2>
          <p class="mt-3 leading-relaxed text-navy-600">{somos.vision}</p>
        </div>
      </aside>
    </div>
  </section>

  <section class="border-t border-steel-200 bg-white pb-20">
    <div class="container-site pt-16">
      <p class="eyebrow">Valores</p>
      <h2 class="mt-3 text-3xl font-bold text-navy-600">Lo que guía nuestro trabajo</h2>
      <ul class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-5">
        {
          somos.valores.map((v) => (
            <li class="flex items-center gap-3 rounded-xl border border-steel-200 p-5">
              <span class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-amber-500 text-steel-900">
                <Icon name="check" class="h-4 w-4" />
              </span>
              <span class="font-semibold text-navy-600">{v}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaBanner />
</Layout>
