---
import Layout from '../layouts/Layout.astro';
import HeroSlider from '../components/HeroSlider.astro';
import ServicioCard from '../components/ServicioCard.astro';
import CtaBanner from '../components/CtaBanner.astro';
import ContactoSection from '../components/ContactoSection.astro';
import Icon from '../components/Icon.astro';
import { getContacto, getServicios, getSomos } from '../lib/wp';
import { slides } from '../data/site';

const [contacto, servicios, somos] = await Promise.all([getContacto(), getServicios(), getSomos()]);

const stats = [
  { valor: '10', label: 'años de experiencia en ingeniería y mantenimiento industrial' },
  { valor: '6', label: 'servicios para tu planta' },
  { valor: '4', label: 'sectores: minero, alimentario, cosmético y químico' },
  { valor: 'Taller + terreno', label: 'mantenimiento en nuestro taller o en tu planta' },
];
---

<Layout
  title="Reserman | Ingeniería y Mantenimiento Industrial"
  description="Reserman: ingeniería de proyectos, soldadura y fabricación, mantenimiento, montaje mecánico, ingeniería eléctrica y obras civiles menores para la industria en Chile."
>
  <HeroSlider contacto={contacto} slides={slides} />

  <!-- Soluciones -->
  <section id="soluciones" class="py-20">
    <div class="container-site">
      <div class="max-w-2xl">
        <p class="eyebrow">Soluciones</p>
        <h2 class="mt-3 text-3xl font-bold text-[#0B2A3A] sm:text-4xl">Nuestros servicios</h2>
        <p class="mt-4 leading-relaxed text-steel-700">
          Ingeniería, fabricación, mantenimiento, montaje y obras para apoyar la continuidad de tu operación.
        </p>
      </div>
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {servicios.map((s) => <ServicioCard servicio={s} />)}
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="border-y border-steel-200 bg-steel-100">
    <div class="container-site grid grid-cols-2 gap-y-6 py-10 md:grid-cols-4 md:divide-x md:divide-steel-200">
      {
        stats.map((s) => (
          <div class="px-4 py-2 text-center">
            <p class="text-3xl font-bold text-navy-600">{s.valor}</p>
            <p class="mt-1.5 text-sm text-steel-700">{s.label}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Somos (resumen) -->
  <section class="bg-navy-600 py-20 text-white">
    <div class="container-site grid items-center gap-12 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <p class="eyebrow text-amber-500">Quiénes somos</p>
        <h2 class="mt-3 text-3xl font-bold sm:text-4xl">Un socio de confianza para tu operación</h2>
        <p class="mt-6 leading-relaxed text-white/80">{somos.intro}</p>
        <p class="mt-4 leading-relaxed text-white/80">{somos.parrafos[0]}</p>
        <a href="/somos" class="btn-primary mt-8">Conocer más <Icon name="arrow" class="h-4 w-4" /></a>
      </div>
      <div class="grid gap-4 lg:col-span-5">
        <div class="rounded-xl border border-white/10 bg-white/5 p-6">
          <h3 class="text-sm font-semibold uppercase tracking-[0.18em] text-amber-500">Misión</h3>
          <p class="mt-3 text-sm leading-relaxed text-white/80">{somos.mision}</p>
        </div>
        <div class="rounded-xl border border-white/10 bg-white/5 p-6">
          <h3 class="text-sm font-semibold uppercase tracking-[0.18em] text-amber-500">Visión</h3>
          <p class="mt-3 text-sm leading-relaxed text-white/80">{somos.vision}</p>
        </div>
      </div>
    </div>
  </section>

  <ContactoSection contacto={contacto} />
  <CtaBanner />
</Layout>
