---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import ServicioCard from '../../components/ServicioCard.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import { getServicios } from '../../lib/wp';

const servicios = await getServicios();
---

<Layout
  title="Soluciones"
  description="Ingeniería de proyectos, soldadura y fabricación, mantenimiento, montaje mecánico, ingeniería eléctrica y obras civiles menores para la industria."
>
  <PageHeader
    eyebrow="Soluciones"
    titulo="Soluciones industriales para tu planta"
    texto="Seis servicios que cubren desde la ingeniería y la fabricación hasta el mantenimiento, el montaje, lo eléctrico y las obras civiles."
    crumbs={[{ label: 'Soluciones' }]}
    imagen="/headers/header-soluciones.webp"
  />

  <section class="py-20">
    <div class="container-site grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {servicios.map((s) => <ServicioCard servicio={s} />)}
    </div>
  </section>

  <CtaBanner />
</Layout>
