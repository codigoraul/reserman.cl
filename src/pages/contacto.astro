---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import ContactoSection from '../components/ContactoSection.astro';
import { getContacto } from '../lib/wp';

const contacto = await getContacto();
const mapaQuery = encodeURIComponent(`${contacto.direccion}, ${contacto.comuna}, ${contacto.ciudad}`);
---

<Layout
  title="Contacto"
  description={`Contáctanos: ${contacto.telefono} · ${contacto.email} · ${contacto.direccion}, ${contacto.comuna}.`}
>
  <PageHeader
    eyebrow="Contacto"
    titulo="Hablemos de tu operación"
    texto="Cotizaciones, auditorías y levantamientos en planta. Te respondemos en horario hábil."
    crumbs={[{ label: 'Contacto' }]}
    imagen="/headers/header-contacto.webp"
  />

  <ContactoSection contacto={contacto} titulo="Escríbenos o llámanos" />

  <section class="pb-0">
    <iframe
      title={`Mapa: ${contacto.direccion}, ${contacto.comuna}`}
      src={`https://www.google.com/maps?q=${mapaQuery}&output=embed`}
      class="h-[380px] w-full border-0 grayscale-[30%]"
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      allowfullscreen
    ></iframe>
  </section>
</Layout>
