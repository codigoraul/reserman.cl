---
interface Props {
  eyebrow?: string;
  titulo: string;
  texto?: string;
  crumbs?: { label: string; href?: string }[];
  imagen?: string;
}
const { eyebrow, titulo, texto, crumbs = [], imagen } = Astro.props;
---

<section class="relative overflow-hidden bg-navy-600 text-white">
  {
    imagen && (
      <>
        <img src={imagen} alt="" width="1920" height="640" class="absolute inset-0 h-full w-full object-cover" loading="eager" decoding="async" />
        <div class="absolute inset-0 bg-[linear-gradient(100deg,rgba(11,59,95,0.88)_0%,rgba(11,59,95,0.7)_55%,rgba(11,59,95,0.35)_100%)]" />
      </>
    )
  }
  <div class="container-site relative flex min-h-[280px] flex-col justify-center py-8">
    {
      crumbs.length > 0 && (
        <nav aria-label="Migas de pan" class="mb-4 text-xs text-white/60">
          <ol class="flex flex-wrap items-center gap-2">
            <li>
              <a href="/" class="hover:text-amber-500">Inicio</a>
            </li>
            {crumbs.map((c) => (
              <li class="flex items-center gap-2">
                <span aria-hidden="true">/</span>
                {c.href ? (
                  <a href={c.href} class="hover:text-amber-500">
                    {c.label}
                  </a>
                ) : (
                  <span class="text-white/85">{c.label}</span>
                )}
              </li>
            ))}
          </ol>
        </nav>
      )
    }
    {eyebrow && <p class="eyebrow text-amber-500">{eyebrow}</p>}
    <h1 class="mt-3 max-w-4xl text-[22px] font-bold leading-tight sm:text-[28px] lg:text-[40px]">{titulo}</h1>
    {texto && <p class="mt-4 max-w-2xl text-lg text-white/80">{texto}</p>}
  </div>
</section>
