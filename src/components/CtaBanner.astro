---
import Icon from './Icon.astro';
interface Props {
  titulo?: string;
  texto?: string;
}
const {
  titulo = '¿Tienes un proyecto o una necesidad en tu planta?',
  texto = 'Cuéntanos qué necesitas y evaluemos una solución para tu empresa.',
} = Astro.props;
---

<section class="bg-amber-500">
  <div class="container-site flex flex-col items-start justify-between gap-5 py-8 md:flex-row md:items-center">
    <div>
      <h2 class="text-xl font-bold text-navy-600 sm:text-2xl">{titulo}</h2>
      <p class="mt-1.5 max-w-2xl text-sm text-navy-600 sm:text-base">{texto}</p>
    </div>
    <a href="/contacto" class="btn-navy shrink-0">
      Solicitar cotización <Icon name="arrow" class="h-4 w-4" />
    </a>
  </div>
</section>
