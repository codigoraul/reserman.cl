---
import Icon from './Icon.astro';
import type { Contacto } from '../data/site';
interface Props {
  contacto: Contacto;
}
const { contacto } = Astro.props;
---

<section class="relative overflow-hidden bg-steel-800 text-white">
  <!-- Fondo: gradiente + trama industrial sutil -->
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_rgba(254,169,1,0.18),_transparent_55%),linear-gradient(135deg,#00405c_0%,#002a3d_60%,#001d2b_100%)]"></div>
  <div
    class="absolute inset-0 opacity-[0.07]"
    style="background-image: linear-gradient(rgba(255,255,255,.6) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.6) 1px, transparent 1px); background-size: 48px 48px;"
  >
  </div>

  <div class="container-site relative grid items-center gap-12 py-20 lg:grid-cols-12 lg:py-28">
    <div class="lg:col-span-7">
      <p class="eyebrow text-amber-400">{contacto.lema}</p>
      <h1 class="mt-4 text-4xl font-bold leading-tight sm:text-5xl lg:text-[3.4rem]">
        Un partner estratégico para <span class="text-amber-500">optimizar tus procesos productivos</span>
      </h1>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-white/80">
        Gestión del mantenimiento, optimización de procesos, servicios de mantenimiento e ingeniería para plantas de
        alimentos, químicas y cosméticas. Más de una década de experiencia liderando áreas técnicas desde dentro de la
        industria.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/contacto" class="btn-primary">
          Solicitar cotización <Icon name="arrow" class="h-4 w-4" />
        </a>
        <a href="/soluciones" class="btn-outline">Ver soluciones</a>
      </div>
    </div>

    <div class="lg:col-span-5">
      <div class="rounded-2xl border border-white/10 bg-white/5 p-6 backdrop-blur-sm sm:p-8">
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-amber-400">¿Por qué Reserman?</p>
        <ul class="mt-5 space-y-4 text-sm text-white/85">
          {
            [
              'Auditorías de mantenimiento basadas en PAS 55 e ISO 55000',
              'Levantamientos en línea, turno completo, con informe final accionable',
              'Planes de mantenimiento a la medida de tu planta',
              'Ingeniería eléctrica industrial y estructuras en acero inoxidable',
            ].map((t) => (
              <li class="flex items-start gap-3">
                <span class="mt-0.5 inline-flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-amber-500 text-steel-900">
                  <Icon name="check" class="h-3 w-3" />
                </span>
                <span>{t}</span>
              </li>
            ))
          }
        </ul>
        <a
          href={`https://wa.me/${contacto.whatsapp}`}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-white transition hover:text-amber-400"
        >
          <Icon name="whatsapp" class="h-4 w-4" /> Conversemos por WhatsApp
        </a>
      </div>
    </div>
  </div>
</section>
