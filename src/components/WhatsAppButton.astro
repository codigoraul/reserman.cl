---
import Icon from './Icon.astro';
interface Props {
  numero: string; // dígitos con código país
  mensaje?: string;
}
const { numero, mensaje = 'Hola Reserman, quisiera cotizar un servicio.' } = Astro.props;
const href = `https://wa.me/${numero}?text=${encodeURIComponent(mensaje)}`;
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Escríbenos por WhatsApp"
  class="fixed bottom-5 right-5 z-50 inline-flex h-14 w-14 items-center justify-center rounded-full bg-[#25D366] text-white shadow-lg shadow-black/25 transition hover:scale-105 hover:bg-[#1ebe5b]"
>
  <Icon name="whatsapp" class="h-7 w-7" />
</a>
