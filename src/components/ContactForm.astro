---
import Icon from './Icon.astro';
import type { Contacto } from '../data/site';
interface Props {
  contacto: Contacto;
  compact?: boolean;
}
const { contacto, compact = false } = Astro.props;
---

<!--
  Formulario estático. Opciones para procesarlo:
  - action a un script PHP en el hosting cPanel (ej: /enviar.php)
  - Formspree / Web3Forms (cambiar action y method="POST")
  Por ahora abre WhatsApp con el mensaje armado (funciona sin backend).
-->
<form id="form-contacto" class="grid gap-4 sm:grid-cols-2" data-whatsapp={contacto.whatsapp} novalidate>
  <div class="sm:col-span-1">
    <label for="nombre" class="mb-1.5 block text-sm font-semibold text-navy-600">Nombre</label>
    <input id="nombre" name="nombre" type="text" required autocomplete="name" class="w-full rounded-md border border-steel-200 bg-white px-4 py-3 text-sm outline-none transition focus:border-amber-500 focus:ring-2 focus:ring-amber-500/30" />
  </div>
  <div class="sm:col-span-1">
    <label for="telefono" class="mb-1.5 block text-sm font-semibold text-navy-600">Teléfono</label>
    <input id="telefono" name="telefono" type="tel" autocomplete="tel" class="w-full rounded-md border border-steel-200 bg-white px-4 py-3 text-sm outline-none transition focus:border-amber-500 focus:ring-2 focus:ring-amber-500/30" />
  </div>
  <div class="sm:col-span-2">
    <label for="email" class="mb-1.5 block text-sm font-semibold text-navy-600">Correo electrónico</label>
    <input id="email" name="email" type="email" required autocomplete="email" class="w-full rounded-md border border-steel-200 bg-white px-4 py-3 text-sm outline-none transition focus:border-amber-500 focus:ring-2 focus:ring-amber-500/30" />
  </div>
  <div class="sm:col-span-2">
    <label for="mensaje" class="mb-1.5 block text-sm font-semibold text-navy-600">Mensaje</label>
    <textarea id="mensaje" name="mensaje" rows={compact ? 4 : 6} required class="w-full rounded-md border border-steel-200 bg-white px-4 py-3 text-sm outline-none transition focus:border-amber-500 focus:ring-2 focus:ring-amber-500/30"></textarea>
  </div>
  <div class="sm:col-span-2 flex flex-wrap items-center gap-4">
    <button type="submit" class="btn-primary">
      Enviar por WhatsApp <Icon name="whatsapp" class="h-4 w-4" />
    </button>
    <p class="text-xs text-steel-400">También puedes escribirnos a <a href={`mailto:${contacto.email}`} class="font-semibold text-navy-600">{contacto.email}</a></p>
  </div>
</form>

<script>
  const form = document.getElementById('form-contacto') as HTMLFormElement | null;
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!form.reportValidity()) return;
    const fd = new FormData(form);
    const texto = [
      `Hola Reserman, mi nombre es ${fd.get('nombre')}.`,
      fd.get('telefono') ? `Teléfono: ${fd.get('telefono')}` : '',
      `Email: ${fd.get('email')}`,
      '',
      String(fd.get('mensaje')),
    ]
      .filter((l) => l !== '')
      .join('\n');
    const num = form.dataset.whatsapp;
    window.open(`https://wa.me/${num}?text=${encodeURIComponent(texto)}`, '_blank', 'noopener');
  });
</script>
